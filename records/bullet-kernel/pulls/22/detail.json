  "title": "Paint colours the terminal can actually render, and keep the hints visible",
  "user": {
    "login": "neverhuman",
    "id": 219957145,
    "node_id": "U_kgDODRxHmQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/219957145?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/neverhuman",
    "html_url": "https://github.com/neverhuman",
    "followers_url": "https://api.github.com/users/neverhuman/followers",
