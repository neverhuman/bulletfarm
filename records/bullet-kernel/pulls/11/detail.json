  "title": "Allow concurrent credential readers and release status locks before HTTP",
  "user": {
    "login": "neverhuman",
    "id": 219957145,
    "node_id": "U_kgDODRxHmQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/219957145?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/neverhuman",
    "html_url": "https://github.com/neverhuman",
    "followers_url": "https://api.github.com/users/neverhuman/followers",
    "following_url": "https://api.github.com/users/neverhuman/following{/other_user}",
    "gists_url": "https://api.github.com/users/neverhuman/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/neverhuman/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/neverhuman/subscriptions",
    "organizations_url": "https://api.github.com/users/neverhuman/orgs",
    "repos_url": "https://api.github.com/users/neverhuman/repos",
    "events_url": "https://api.github.com/users/neverhuman/events{/privacy}",
