{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bullet.farm/assurance/bullet.assurance-inventory.v1.schema.json",
  "title": "Bullet assurance inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "evidence_classes",
    "follow_on_phases",
    "source_contracts",
    "corpus_roles",
    "gaps",
    "waves",
    "slices",
    "work_packages",
    "release_profiles",
    "gate_bindings"
  ],
  "properties": {
    "schema": {
      "const": "bullet.assurance-inventory.v1"
    },
    "authority": {
      "const": "planning-and-component-inventory-only"
    },
    "evidence_classes": {
      "const": [
        "DESIGNED",
        "COMPONENT",
        "TRANSACTION",
        "LIVE",
        "RELEASE"
      ]
    },
    "follow_on_phases": {
      "const": [
        "POST_V1",
        "RETIRED"
      ]
    },
    "source_contracts": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "corpus_roles": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "enum": [
          "historical-provenance",
          "analysis-source",
          "design-source"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "waves": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/wave"
      }
    },
    "slices": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/slice"
      }
    },
    "work_packages": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "release_profiles": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "gate_bindings": {
      "type": "array",
      "minItems": 46,
      "maxItems": 46,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "evidence": {
      "enum": [
        "DESIGNED",
        "COMPONENT",
        "TRANSACTION",
        "LIVE",
        "RELEASE"
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "path",
        "schema"
      ],
      "properties": {
        "scope": {
          "enum": [
            "hub",
            "family-root"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "waves",
        "evidence_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G([1-9]|1[0-8])$"
        },
        "waves": {
          "$ref": "#/$defs/ids"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "indirect_gate": {
          "type": "string",
          "pattern": "^release\\."
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depends_on",
        "gaps",
        "slices",
        "work_packages",
        "evidence_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^W([0-9]|1[01])$"
        },
        "depends_on": {
          "$ref": "#/$defs/ids"
        },
        "gaps": {
          "$ref": "#/$defs/ids"
        },
        "slices": {
          "$ref": "#/$defs/ids"
        },
        "work_packages": {
          "$ref": "#/$defs/ids"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "waves",
        "evidence_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^V1-S[0-8]$"
        },
        "waves": {
          "$ref": "#/$defs/ids"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lifecycle",
        "waves",
        "follow_on",
        "owner",
        "evidence_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WP-(0[1-9]|1[0-9]|2[0-3])$"
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "RETIRED"
          ]
        },
        "waves": {
          "$ref": "#/$defs/ids"
        },
        "follow_on": {
          "$ref": "#/$defs/ids"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "condition_gate",
        "current_result"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "enum": [
            "product",
            "diagnostic"
          ]
        },
        "condition_gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_result": {
          "const": "BLOCKED"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gaps",
        "required_evidence_class",
        "receipt_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^release\\."
        },
        "gaps": {
          "$ref": "#/$defs/ids"
        },
        "required_evidence_class": {
          "enum": [
            "TRANSACTION",
            "LIVE",
            "RELEASE"
          ]
        },
        "receipt_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "artifact",
            "containment",
            "forge",
            "operations",
            "profile-closure",
            "provider",
            "rust-toolchain",
            "scanner",
            "transaction",
            null
          ]
        }
      }
    }
  }
}
