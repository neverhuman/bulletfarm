{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neverhuman.org/schemas/bullet.paper-evidence.v1.json",
  "title": "Bullet Farm paper evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "repositories",
    "toolchain",
    "commands",
    "results",
    "maturity",
    "external_observations",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": { "const": "bullet.paper-evidence.v1" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "captured_at", "source_date_epoch", "stage", "family_clean", "transaction_proof"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "source_date_epoch": { "type": "integer", "minimum": 1 },
        "stage": { "enum": ["architecture-component-assurance", "benchmarked-revision"] },
        "family_clean": { "type": "boolean" },
        "transaction_proof": { "type": "boolean" }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "commit", "tree", "clean_at_capture"],
        "properties": {
          "name": { "enum": ["bullet-farm", "bullet-kernel", "bullet-git", "bullet-portal"] },
          "path": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "clean_at_capture": { "type": "boolean" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "cargo", "git", "just", "jq", "pdflatex", "bibtex", "poppler"],
      "properties": {
        "rustc": { "type": "string", "minLength": 1 },
        "cargo": { "type": "string", "minLength": 1 },
        "git": { "type": "string", "minLength": 1 },
        "just": { "type": "string", "minLength": 1 },
        "jq": { "type": "string", "minLength": 1 },
        "pdflatex": { "type": "string", "minLength": 1 },
        "bibtex": { "type": "string", "minLength": 1 },
        "poppler": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "command", "outcome", "exit_code", "boundary"],
        "properties": {
          "repository": { "enum": ["bullet-farm", "bullet-kernel", "bullet-git", "bullet-portal"] },
          "command": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "boundary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "results": { "type": "object" },
    "maturity": {
      "type": "array",
      "const": ["Designed", "Component-proved", "Transaction-proved", "Live/release-proved"]
    },
    "external_observations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subject", "observed_at", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
