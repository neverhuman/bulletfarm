#!/usr/bin/env bash
# One entry point for CI and reviewers. No browser, no model, no network beyond npm/cargo registries.
set -euo pipefail
cd "$(dirname "$0")/.."
want_node="v$(tr -d '[:space:]' < web/.nvmrc)"; want_npm="10.9.8"
have_node="$(node --version)"; have_npm="$(npm --version)"
if [ "$have_node" != "$want_node" ] || [ "$have_npm" != "$want_npm" ]; then
  echo "scripts/check: need node $want_node / npm $want_npm, have $have_node / $have_npm (nvm use; npm i -g npm@$want_npm)" >&2
  exit 64
fi
npm --prefix web ci --ignore-scripts --no-audit --no-fund
npm --prefix web run typecheck
npm --prefix web test -- --run
bash scripts/build-web --check
cargo fmt --all -- --check
cargo clippy --locked --all-targets -- -D warnings
cargo test --locked
cargo build --locked --bin bf
