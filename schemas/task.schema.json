{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bulletfarm.dev/schemas/task.schema.json",
  "title": "Task v3",
  "type": "object",
  "required": ["schema_version", "id", "revision", "mission_id", "repo_id", "owner_id", "kind", "acceptance"],
  "properties": {
    "schema_version": { "const": 3 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string" },
    "delivery_goal": { "enum": ["pr_ready", "merged"] }
  },
  "additionalProperties": true
}
